# Copy to .env.local and fill in your values

# App configuration — must match the production brand (PDF Guru / pdfguru.site)
VITE_APP_NAME="PDF Guru"
VITE_APP_URL="https://pdfguru.site"
VITE_APP_DESCRIPTION="Convert, extract, and transform PDF documents into usable data — your expert PDF toolkit."
VITE_APP_TAGLINE="Your Expert PDF Toolkit."
VITE_SUPPORT_EMAIL=""

# Backend API (optional — leave blank for browser-only mode)
VITE_BACKEND_URL=""

# External API keys (optional)
VITE_OCR_API_KEY=""

# Cloudflare Turnstile CAPTCHA (optional — defaults to Cloudflare always-pass test key in dev)
# Site Key for frontend (Visible in public)
VITE_TURNSTILE_SITE_KEY=""
# Secret Key for Cloudflare Worker (Set via: npx wrangler secret put TURNSTILE_SECRET_KEY)
# TURNSTILE_SECRET_KEY=""

# Optional donation link (e.g. Lemon Squeezy, Buy Me a Coffee). Leave blank to hide all donate buttons.
VITE_DONATE_URL=""
